class Agent:


    def __init__(
        self,
        name,
        tools
    ):
        self.name=name
        self.tools=tools


    def execute(
        self,
        task
    ):

        return {
            "agent":self.name,
            "task":task,
            "status":"completed"
        }



security_agent = Agent(
    "Security Agent",
    [
        "scan",
        "audit"
    ]
)


print(
    security_agent.execute(
        "Review AI application"
    )
)
