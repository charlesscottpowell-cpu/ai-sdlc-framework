name: AI Application Pipeline

on:
  push:
    branches:
      - main

jobs:

  test-ai:

    runs-on: ubuntu-latest

    steps:

    - uses: actions/checkout@v4

    - name:
        Install dependencies

      run:
        pip install -r requirements.txt


    - name:
        Run AI Evaluation

      run:
        python tests/evaluate_model.py
